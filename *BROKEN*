def steam_roots():
    candidates = [
        Path(os.environ.get(
            "PROGRAMFILES(X86)", r"C:\Program Files (x86)"
        )) / "Steam",
        Path(os.environ.get(
            "PROGRAMFILES", r"C:\Program Files"
        )) / "Steam",
        Path(os.environ.get("LOCALAPPDATA", "")) / "Steam",
    ]

    if os.name == "nt":
        try:
            import winreg

            for hive in (
                winreg.HKEY_CURRENT_USER,
                winreg.HKEY_LOCAL_MACHINE,
            ):
                for key in (
                    r"Software\Valve\Steam",
                    r"Software\WOW6432Node\Valve\Steam",
                ):
                    try:
                        with winreg.OpenKey(hive, key) as handle:
                            value, _ = winreg.QueryValueEx(
                                handle, "SteamPath"
                            )
                            candidates.append(Path(value))
                    except OSError:
                        pass
        except ImportError:
            pass

    roots = []
    for root in candidates:
        try:
            root = root.resolve()
            if (root / "steamapps").is_dir() and root not in roots:
                roots.append(root)
        except OSError:
            pass

    return roots


def library_dirs():
    result = []

    for root in steam_roots():
        candidates = [root / "steamapps"]
        vdf = root / "steamapps" / "libraryfolders.vdf"

        if vdf.is_file():
            try:
                text = vdf.read_text(encoding="utf-8", errors="ignore")

                for match in re.finditer(
                    r'"(?:path|[0-9]+)"\s*"([^"]+)"', text
                ):
                    raw_path = match.group(1).replace("\\\\", "\\")
                    library_root = Path(raw_path)

                    if library_root.is_absolute():
                        candidates.append(library_root / "steamapps")
            except OSError:
                pass

        for candidate in candidates:
            try:
                candidate = candidate.resolve()
                if candidate.is_dir() and candidate not in result:
                    result.append(candidate)
            except OSError:
                pass

    return result


def parse_manifest(path):
    try:
        text = path.read_text(encoding="utf-8", errors="ignore")

        appid = re.search(r'"appid"\s*"(\d+)"', text)
        name = re.search(r'"name"\s*"([^"]+)"', text)
        install = re.search(r'"installdir"\s*"([^"]+)"', text)

        if not appid or not name:
            return None

        folder_name = install.group(1) if install else name.group(1)
        folder = path.parent / "common" / folder_name

        return {
            "appid": appid.group(1),
            "name": name.group(1),
            "folder": folder,
            "available": folder.is_dir(),
            "owned": False,
            "catalog_only": False,
        }
    except OSError:
        return None


def scan_local_games():
    games = {}

    for apps in library_dirs():
        try:
            manifests = apps.glob("appmanifest_*.acf")
            for manifest in manifests:
                game = parse_manifest(manifest)
                if game:
                    games[game["appid"]] = game
        except OSError:
            pass

    return games


