    # Locking and shutdown

    def lock_app(self):
        self.password = None
        self.build_gate()

    def closeEvent(self, event):
        old = self.centralWidget()

        if isinstance(old, BackgroundContainer):
            old.stop()

        for worker in list(self.workers):
            if worker.isRunning():
                worker.quit()
                if not worker.wait(1500):
                    worker.wait()

        event.accept()


